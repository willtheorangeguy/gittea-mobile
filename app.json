{
  "expo": {
    "name": "Gitea Mirror Mobile",
    "slug": "gitea-mirror-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "gitea-mirror-mobile",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071917"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raylabshq.giteamirrormobile"
    },
    "android": {
      "package": "com.raylabshq.giteamirrormobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071917"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
